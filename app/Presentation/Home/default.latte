{* This is the welcome page, you can delete it *}

{import '../@cubes.latte'}

{* web font only here, error pages must not depend on a CDN *}
{block head}
	<link rel="preconnect" href="https://fonts.bunny.net">
	<link rel="stylesheet" href="https://fonts.bunny.net/css?family=instrument-sans:400,500,600,700">
{/block}

{block content}
<main class="blueprint flex min-h-dvh flex-col items-center justify-center px-4 py-16 text-center text-white">
	<div class="w-40 sm:w-52">{include latticeComplete}</div>

	<h1 n:block=title class="mt-12 text-[clamp(2.4rem,11.5vw,4.5rem)] leading-none font-bold tracking-[-0.045em] whitespace-nowrap">Congratulations<span class="bang" aria-hidden="true"><svg viewBox="35.84 1.78 440.32 508.44" xmlns="http://www.w3.org/2000/svg"><path d="M256 1.78 476.16 128.89 256 256 35.84 128.89Z" fill="#ff7a6e"/><path d="M35.84 128.89 256 256v254.22L35.84 383.11Z" fill="#ff2d20"/><path d="M256 256 476.16 128.89v254.22L256 510.22Z" fill="#a8150c"/></svg></span><span class="sr-only">!</span></h1>

	<h2 class="mt-8 text-xl leading-snug font-medium text-mist sm:text-2xl">You have successfully created your <a class="blueprint-link" href="https://nette.org">Nette</a> Web project.</h2>

	<p class="mt-5 max-w-xl text-lg leading-relaxed text-balance text-haze">If you are exploring Nette for the first time, you should read the
	<a class="blueprint-link" href="https://doc.nette.org/quickstart">Quick Start</a>, <a class="blueprint-link" href="https://doc.nette.org">documentation</a>,
	<a class="blueprint-link" href="https://blog.nette.org">blog</a> and <a class="blueprint-link" href="https://forum.nette.org">forum</a>.</p>

	<h2 class="mt-14 border-t border-white/10 pt-8 text-xl font-semibold tracking-tight sm:text-2xl">We hope you enjoy Nette!</h2>
</main>
