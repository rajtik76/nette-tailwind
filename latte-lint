#!/usr/bin/env php
<?php declare(strict_types=1);

/**
 * Lints Latte templates with the application's own Latte engine (custom filters, functions, strictParsing).
 * Unlike Latte\Tools\Linter, warnings (unknown filter/function/class, BOM) fail the run too,
 * because they would fail at render time.
 *
 * Usage: php latte-lint [path=app]
 */

require __DIR__ . '/vendor/autoload.php';

$path = $argv[1] ?? 'app';

// debug mode rebuilds the container when config changes, so the linter sees current Latte extensions
$bootstrap = new App\Bootstrap;
$container = $bootstrap->bootConsoleApplication(debugMode: true);
$presenter = $container->getByType(Nette\Application\IPresenterFactory::class)
	->createPresenter('Home');
$latte = $container->getByType(Nette\Bridges\ApplicationLatte\TemplateFactory::class)
	->createTemplate($presenter)
	->getLatte();

$latte->addExtension(new Latte\Tools\LinterExtension);
$latte->enablePhpLinter(PHP_BINARY);
$latte->setLoader(new Latte\Loaders\StringLoader);

$files = is_file($path)
	? [$path]
	: Nette\Utils\Finder::findFiles('*.latte')->from($path);

$report = function (string $label, string $file, string $message): void {
	fwrite(STDERR, str_pad("[$label]", 13) . " $file    $message\n");
};

$checked = $errors = $warnings = 0;

foreach ($files as $file) {
	$file = (string) $file;
	$checked++;
	$source = (string) file_get_contents($file);

	if (str_starts_with($source, "\xEF\xBB\xBF")) {
		$report('WARNING', $file, 'contains BOM');
		$warnings++;
	}

	set_error_handler(function (int $severity, string $message) use ($file, $report, &$warnings): bool {
		if (!in_array($severity, [E_USER_DEPRECATED, E_USER_WARNING, E_USER_NOTICE], true)) {
			return false;
		}

		$line = preg_match('~on line (\d+)~', $message, $m) ? ':' . $m[1] : '';
		if ($severity === E_USER_DEPRECATED) {
			$report('DEPRECATED', $file . $line, $message);
		} else {
			$report('WARNING', $file . $line, $message);
			$warnings++;
		}
		return true;
	});

	try {
		$latte->compile($source);

	} catch (Latte\CompileException $e) {
		$position = $e->position ? ":{$e->position->line}:{$e->position->column}" : '';
		$report('ERROR', $file . $position, $e->getMessage());
		$errors++;

	} finally {
		restore_error_handler();
	}
}

echo "Checked $checked Latte files: $errors error(s), $warnings warning(s)\n";
exit($errors || $warnings ? 1 : 0);
